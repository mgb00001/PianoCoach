# Python env / caches
.venv/
__pycache__/
*.pyc

# Generator working data — analysed songs + uploaded source audio.
# Excluded because these are commercial recordings (copyright), not project code,
# and are regenerable locally via the Generator (see README "Run the Generator").
# Both directories are created automatically on first use (mkdir(parents=True)).
samples/
webgen/uploads/

# Local download/unpack area for the Generator's outputs — exported metadata zips and
# generated standalone players. Build artefacts of songs above, so same reasoning: they
# contain commercial recordings, are regenerable from the Generator, and are not project code.
exportdownloads/
playerdownloads/
catalog/

# Copyrighted source recordings used for local testing (never publish these).
# The extension rules cover stray files anywhere; "audio files/" is the folder they're
# kept in, ignored wholesale so nothing in it can be committed regardless of format.
audio files/
*.mp3
*.m4a
*.wav

# Claude Code local settings (personal permission grants, not shared config)
.claude/settings.local.json

# OS / editor cruft
.DS_Store
Thumbs.db
